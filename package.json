{
  "name": "conversor-mts",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Conversor MTS - DLCCS: converte vídeos AVCHD (.MTS/.M2TS) em MP4 direto no navegador.",
  "scripts": {
    "postinstall": "node scripts/copy-ffmpeg.mjs",
    "prebuild": "node scripts/copy-ffmpeg.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fixtures": "bash scripts/make-fixtures.sh",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.6",
    "@ffmpeg/core-mt": "0.12.6",
    "@ffmpeg/ffmpeg": "0.12.10",
    "@ffmpeg/util": "0.12.1",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/share-tech-mono": "5.3.0",
    "lucide": "1.58.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
